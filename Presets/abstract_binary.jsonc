// Fastfetch config for CachyOS // Hyprland //
// GitOwl58 //
// Enjoy //

  
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
    	"source": "~/.config/fastfetch/images/abstract_binary.png",
    	"type": "kitty",
      	"height": 20,
      	"padding": {
    		"top": 1
      	}
    },
    "display": {
          "separator": " ➜  "
    },
    "modules": [
        "break",
        "break",
        "break",
         {
            "type": "os",
            "key": "OS   ",
            "keyColor": "34",  // = color1
        },
        {
            "type": "kernel",
            "key": " ├  ",
            "keyColor": "34",
        },
        {
            "type": "packages",
            "format": "",
            "key": " ├ 󰏖 ",
            "keyColor": "34",  
        },
        {
            "type": "shell",
            "key": " └  ",
            "keyColor": "34", 
        },
        "break",
        {
            "type": "wm",
            "key": "WM   ",
            "keyColor": "34", 
        },
        {
            "type": "wmtheme",
            "key": " ├ 󰉼 ",
            "keyColor": "34",
        },
        {
            "type": "icons",
            "key": " ├ 󰀻 ",
            "keyColor": "34",
        },
        {
            "type": "cursor",
            "key": " ├  ",
            "keyColor": "34", 
        },
        {
            "type": "terminal",
            "key": " └  ",
            "keyColor": "34",
	},
        "break",
        {
            "type": "title",
            "key": "PC   ",
	    "format": "{host-name}",
            "keyColor": "34",
        },
        {
            "type": "cpu",
            "format": "{1} {3}/{cores-logical} @ {7}",
            "key": " ├  ",
            "keyColor": "34",
        },
        {
            "type": "gpu",
            "format": "{2}",            
            "key": " ├ 󰢮 ",
            "keyColor": "34",
        },
        {
            "type": "memory",
            "key": " ├  ",
            "keyColor": "34",
	},
        {
            "type": "disk",
            "key": " ├ 󰋊 ",
            "keyColor": "34",
        },
        {
            "type": "monitor",
            "key": " └  ",
	    "format": "{width}x{height} @ {refresh-rate}Hz",
            "keyColor": "34",
	},
        "break",
        "break",
    ]
}
