// Fastfetch config for CachyOS // Hyprland //
// GitOwl58 //
// Enjoy //


{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
      "type": "kitty",
      "source": "~/.config/fastfetch/images/cachylogo.png",
      "width": 48
	},
	"display": {
		"separator": "  "
	},
	"modules": [
		{
			"type": "title",
			"keyColor": "blue"
		},
		"break",
		{
			"type": "os",
			"key": "╭─",
			"keyColor": "blue"
		},
		{
			"type": "kernel",
			"key": "├─",
			"format": "{1} {2}",
			"keyColor": "blue"
		},
		{
			"type": "packages",
			"key": "├─󰮯",
			"keyColor": "blue"
		},
		{
			"type": "de",
			"key": "├─",
			"keyColor": "blue"
		},
		{
			"type": "wm",
			"key": "├─",
			"keyColor": "blue"
		},
		{
			"type": "lm",
			"key": "├─󰧨",
			"keyColor": "blue"
		},
		{
			"type": "theme",
			"key": "├─󰉼",
			"keyColor": "blue"
		},
		{
			"type": "icons",
			"key": "╰─󰀻",
			"keyColor": "blue"
		},
		"break",
		{
			"type": "terminal",
			"key": "╭─",
			"keyColor": "green"
		},
		{
			"type": "terminalfont",
			"key": "├─",
			"keyColor": "green"
		},
		{
			"type": "shell",
			"key": "╰─",
			"keyColor": "green"
		},
		"break",
		{
			"type": "host",
			"key": "╭─",
			"keyColor": "yellow"
		},
		{
			"type": "cpu",
			"key": "├─󰍛",
			"keyColor": "yellow"
		},
		{
			"type": "gpu",
			"key": "├─󰘚",
			"keyColor": "yellow",
			"format": "{name}"
		},
		{
			"type": "display",
			"key": "├─󰍹",
			"keyColor": "yellow"
		},
		{
			"type": "memory",
			"key": "├─󰑭",
			"keyColor": "yellow"
		},
		{
			"type": "uptime",
			"key": "╰─󰅐",
			"keyColor": "yellow"
		},
		"break", "colors"
	]
}
